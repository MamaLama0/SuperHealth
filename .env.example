# Optional overrides. No .env file is needed for docker compose up -d.
RELAY_PORT=8787
RELAY_BIND=0.0.0.0
MAX_CARDS=500
RATE_LIMIT_PER_MINUTE=240
MAX_IN_FLIGHT=8
# Global media capacity: 100 GB (decimal bytes), shared by all mailboxes.
MEDIA_QUOTA_BYTES=100000000000
MAX_MEDIA_FILES=10000
# Private custom server only; 32..512 characters. Empty = no shared code.
PUBLISH_KEY=
# Optional compose.https.yaml override:
DOMAIN=amis.exemple.fr
HTTP_PORT=8080
HTTPS_PORT=8443

# Existing bind-mount installation only; keep its directory and matching UID/GID.
# DATA_PATH=/absolute/path/to/existing/data
# PUID=568
# PGID=568
