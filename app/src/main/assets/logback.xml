<configuration debug="true">

    <appender name="STDOUT" class="ch.qos.logback.classic.android.LogcatAppender">
        <!-- encoders are  by default assigned the type
             ch.qos.logback.classic.encoder.PatternLayoutEncoder -->
        <tagEncoder>
            <pattern>%logger{80}</pattern>
        </tagEncoder>
        <!-- include [%-20thread] to print thread -->
        <encoder>
            <pattern>%msg</pattern>
        </encoder>
    </appender>

    <!-- Raised to DEBUG or TRACE by app.superhealth.engine.Logging, depending on
         where the log is being written. This level applies until it does so. -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <!-- The FILE appender is added programmatically by app.superhealth.engine.Logging -->
    </root>
</configuration>